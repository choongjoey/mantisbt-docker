## Override the deny-all from plugins/.htaccess for the specific endpoints the
## Attachments plugin POSTs to directly (it bypasses plugin.php and includes
## core.php itself, so Apache must let the request through for auth to run).
## Scoped to named files so any other PHP added to this folder stays denied.

<FilesMatch "^(upload_attachments|attachments_form)\.php$">
	# Apache 2.4
	<IfModule mod_authz_core.c>
		Require all granted
	</IfModule>

	# Apache 2.2
	<IfModule !mod_authz_core.c>
		Order Allow,Deny
		Allow from all
	</IfModule>
</FilesMatch>
